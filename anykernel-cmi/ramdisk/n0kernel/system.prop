# N0kernel 运行时开关默认值（stage C 清单，共 11 个主开关）
# Magisk/KSU 模块加载本文件；无 root 方案时 n0kernel-tune.sh 用 defprop 自行兜底。
# 修改方式：setprop persist.n0kernel.<key> <value> 后重启，或编辑本文件。
# zram 压缩器：zmako（最快），可切 lz4kd / zmako_h / lz4k_oplus / lz4
persist.n0kernel.zram.comp_algorithm=zmako
# zram 容量：空=沿用 Rom，例 4G / 6G
persist.n0kernel.zram.disksize=
# zram 回写总开关：0=关（默认）。=1 且 backing_dev 非空才启用
persist.n0kernel.zram.writeback=0
# 回写目标块设备（上一项=1 时使用）
persist.n0kernel.zram.backing_dev=
# 磁盘/文件 swap 总开关：0=关（默认）
persist.n0kernel.swap.enable=0
# 0-200，保活/流畅平衡
persist.n0kernel.vm.swappiness=100
# 提前异步回收，减少 direct reclaim
persist.n0kernel.vm.watermark_scale_factor=100
# 设 0 完全关闭 UKSM
persist.n0kernel.uksm.run=1
# 把默认 95 降下来（核心流畅开关，范围 10-99）
persist.n0kernel.uksm.max_cpu=30
# full / medium / low / quiet
persist.n0kernel.uksm.governor=low
# lmkd 杀进程阈值：空=沿用 Rom（cmi 走 simple_lmk，cas 走标准 lmkd，语义不同）
persist.n0kernel.lmk.minfree=
# 辅助属性（不计入 11 个主开关）：swap.enable=1 时的 swapon 目标
persist.n0kernel.swap.device=
